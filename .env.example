# Copy to .env and `set -a; source .env; set +a` before starting the app.
NESTACK_DB_PATH=./nestack.db
NESTACK_SESSION_TTL=28800
NESTACK_LOCKOUT_THRESHOLD=5
NESTACK_LOCKOUT_SECONDS=900
NESTACK_MAX_BODY_BYTES=65536
NESTACK_ENABLE_DOCS=true
NESTACK_LOG_LEVEL=INFO

# Optional defense-in-depth. Set a long random value, keep it out of git, and
# never change it after accounts exist or every password stops verifying.
# NESTACK_PASSWORD_PEPPER=replace-with-at-least-16-random-characters
